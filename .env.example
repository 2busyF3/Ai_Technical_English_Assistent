APP_ENV=development
DATABASE_URL=postgresql+asyncpg://tutor:tutor@postgres:5432/tutor
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=30
